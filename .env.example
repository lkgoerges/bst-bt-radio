BT_RADIO_PORT=3090
BT_RADIO_HOST=0.0.0.0
BT_RADIO_SITE=home
BT_RADIO_CONFIG=./data/config.json
BT_RADIO_STATE=./data/state.json
BT_RADIO_MOCK=0
BT_RADIO_MPV_SOCKET=/tmp/bst-bt-radio-mpv.sock
# Optional: force BlueZ commands to use a specific controller address, e.g. a USB Bluetooth stick.
BT_RADIO_BLUETOOTH_CONTROLLER=
