BT_RADIO_PORT=3090
BT_RADIO_HOST=0.0.0.0
BT_RADIO_SITE=home
BT_RADIO_CONFIG=./data/config.json
BT_RADIO_STATE=./data/state.json
BT_RADIO_MOCK=0
BT_RADIO_MPV_SOCKET=/tmp/bst-bt-radio-mpv.sock
# Optional: force a PipeWire/WirePlumber sink id or node name from `wpctl status`.
# Leave empty to use the Pi's current default output, usually the analog jack after raspi-config.
BT_RADIO_AUDIO_SINK=
