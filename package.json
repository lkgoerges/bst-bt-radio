{
  "name": "bst-bt-radio",
  "version": "0.1.0",
  "private": true,
  "description": "Local Raspberry Pi Bluetooth radio bridge for Bose SoundTouch speakers.",
  "type": "module",
  "scripts": {
    "dev": "BT_RADIO_MOCK=1 tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "@types/ws": "^8.5.11",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
